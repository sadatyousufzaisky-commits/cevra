{
  "name": "cevra",
  "version": "0.1.0",
  "description": "CEVRA desktop development workspace",
  "main": "src/main.cjs",
  "scripts": {
    "build": "esbuild src/workbench.js --bundle --minify --outfile=dist/workbench.js",
    "start": "npm run build && electron .",
    "test": "npm run test:core && npm run test:desktop",
    "test:core": "node --test qa/core.test.cjs",
    "test:desktop": "npm run build && node --test qa/workbench.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "playwright": "1.65.0"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2",
    "typescript": "6.0.3"
  }
}
