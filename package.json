{
  "name": "cevra",
  "version": "0.1.0",
  "description": "CEVRA desktop development workspace",
  "main": "src/main.cjs",
  "scripts": {
    "build": "npm run build:host && esbuild src/workbench.js --bundle --minify --outfile=dist/workbench.js",
    "build:host": "node scripts/build-process-host.cjs",
    "start": "npm run build && electron .",
    "test": "npm run test:core && npm run test:desktop",
    "test:core": "npm run build:host && node --test --test-concurrency=1 qa/core.test.cjs qa/extensions.test.cjs",
    "test:desktop": "npm run build && node --test --test-concurrency=1 qa/continuum.test.cjs qa/workbench.test.cjs",
    "benchmark": "npm run build && node qa/benchmark.cjs",
    "benchmark:continuum": "npm run build && node --test qa/continuum.test.cjs",
    "inspect:extension": "node scripts/inspect-extension.cjs",
    "test:extensions": "node --test qa/extensions.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "playwright": "1.65.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "typescript": "6.0.3"
  }
}
